{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@api/*":        ["src/api/*"],
      "@assets/*":     ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@context/*":    ["src/context/*"],
      "@pages/*":      ["src/pages/*"],
      "@styles/*":     ["src/styles/*"]
    },
    "checkJs": false
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
